pragma tolang 0.4.0;

// ConfidentialAMM — a constant-product AMM where LP balances are encrypted.
//
// The pool's reserve ratio is public (needed for price discovery), but each
// LP's individual share is an ElGamal ciphertext. Only the LP can decrypt
// their own position. This prevents front-running based on LP position sizes.
//
// Demonstrates:
//   - tos.ciphertext.mul_scalar / div_scalar for proportional calculations
//   - tos.scalar.* for fee math
//   - tos.ristretto.* for custom commitment construction
//   - tos.proof.verify_balance for balance sufficiency checks

contract ConfidentialAMM {
    agent token_a;
    agent token_b;
    u256 reserve_a;
    u256 reserve_b;
    u64 total_lp_shares;
    u64 fee_bps;             // fee in basis points (e.g. 30 = 0.3%)

    mapping(agent => bytes32) publicKeys;
    mapping(agent => ciphertext) lpShares;

    event LiquidityAdded(agent indexed provider, u64 shares)
    event LiquidityRemoved(agent indexed provider, u64 shares)
    event Swap(agent indexed trader, agent indexed tokenIn, u256 amountIn, u256 amountOut)

    constructor(agent _token_a, agent _token_b, u64 _fee_bps) {
        set token_a = _token_a;
        set token_b = _token_b;
        set fee_bps = _fee_bps;
        set total_lp_shares = 0;
        set reserve_a = 0;
        set reserve_b = 0;
    }

    function registerPublicKey(bytes32 pubkey) external {
        set publicKeys[msg.sender] = pubkey;
    }

    // Add liquidity and receive encrypted LP shares.
    //
    // The number of LP shares minted is public (derived from reserves), but
    // each LP's cumulative position is stored as an encrypted ciphertext
    // so other LPs cannot see individual position sizes.
    function addLiquidity(u256 amount_a, u256 amount_b) external {
        let pubkey: bytes32 = publicKeys[msg.sender];
        require(pubkey != bytes32(0), "NotRegistered");

        // Calculate shares to mint (simplified: proportional to amount_a)
        let shares: u64 = 0;
        if (total_lp_shares == 0) {
            // Initial liquidity: shares = amount_a (as u64)
            shares = u64(amount_a);
        }
        // (Omitted: proportional minting for non-initial case for brevity)

        // Encrypt the new shares under the LP's public key
        let newSharesCt: ciphertext = tos.ciphertext.encrypt(pubkey, shares);

        // Homomorphic add to LP's existing encrypted position
        let currentShares: ciphertext = lpShares[msg.sender];
        set lpShares[msg.sender] = tos.ciphertext.add(currentShares, newSharesCt);

        set total_lp_shares = total_lp_shares + shares;
        set reserve_a = reserve_a + amount_a;
        set reserve_b = reserve_b + amount_b;

        emit LiquidityAdded(msg.sender, shares);
    }

    // Remove liquidity: prove you own at least `shares` encrypted LP tokens,
    // then burn them and receive proportional reserves.
    //
    // Uses a balance proof to verify the LP has enough shares without revealing
    // their total position.
    function removeLiquidity(
        u64 shares,
        bytes balanceProofBytes
    ) external {
        let pubkey: bytes32 = publicKeys[msg.sender];
        require(pubkey != bytes32(0), "NotRegistered");
        require(shares > 0, "ZeroShares");

        let t: bytes32 = tos.transcript.new("remove-liquidity");

        // Verify balance proof: LP has at least `shares` encrypted tokens
        let currentShares: ciphertext = lpShares[msg.sender];
        require(
            tos.proof.verify_balance(pubkey, currentShares, balanceProofBytes, t),
            "BadBalanceProof"
        );

        let proofAmount: u64 = tos.proof.balance_amount(balanceProofBytes);
        require(proofAmount >= shares, "InsufficientShares");

        // Subtract shares from encrypted position
        let newShares: ciphertext = tos.ciphertext.sub_scalar(currentShares, shares);
        set lpShares[msg.sender] = newShares;

        set total_lp_shares = total_lp_shares - shares;

        emit LiquidityRemoved(msg.sender, shares);
    }

    // Scale an LP's encrypted shares by a fee multiplier.
    // Example: after collecting fees, multiply all LP shares by (1 + fee/total).
    // This demonstrates tos.ciphertext.mul_scalar and div_scalar.
    function distributeFeesToLP(agent lp, u64 numerator, u64 denominator) external {
        require(msg.sender == token_a, "OnlyProtocol");  // permissioned
        require(denominator > 0, "ZeroDenominator");

        let ct: ciphertext = lpShares[lp];

        // Proportional scale: newShares = oldShares * numerator / denominator
        let scaled: ciphertext = tos.ciphertext.mul_scalar(ct, numerator);
        let result: ciphertext = tos.ciphertext.div_scalar(scaled, denominator);
        set lpShares[lp] = result;
    }

    function getReserves() public view returns (u256 ra, u256 rb) {
        return reserve_a;
    }

    function getEncryptedShares(agent lp) public view returns (ciphertext) {
        return lpShares[lp];
    }
}
