pragma tolang 0.4.0;

// ConfidentialToken — fully private TRC20-style token.
//
// All balances are uno (Twisted ElGamal ciphertexts). The contract never sees
// any plaintext amount — it only does encrypted arithmetic and verifies proofs
// via the proof bundle mechanism.
//
// What's public:  transfer events (from, to)
// What's hidden:  all balances, all transfer amounts

contract ConfidentialToken {
    agent minter;
    mapping(agent => uno) balances;
    mapping(agent => bytes32) publicKeys;

    event PublicKeyRegistered(agent indexed account, bytes32 pubkey)
    event Mint(agent indexed to)
    event ConfidentialTransfer(agent indexed from, agent indexed to)
    event Burn(agent indexed from)

    constructor(agent _minter) {
        set minter = _minter;
    }

    function registerPublicKey(bytes32 pubkey) external {
        set publicKeys[msg.sender] = pubkey;
        emit PublicKeyRegistered(msg.sender, pubkey);
    }

    // Mint: minter creates encrypted amount off-chain, submits as uno.
    function mint(agent to, uno mintAmount) external {
        require(msg.sender == minter, "OnlyMinter");
        require(publicKeys[to] != bytes32(0), "NotRegistered");
        set balances[to] = balances[to].add(mintAmount);
        emit Mint(to);
    }

    // Transfer: pure encrypted arithmetic. SDK generates proof bundle.
    function transfer(agent to, uno amount) external {
        require(publicKeys[msg.sender] != bytes32(0), "SenderNotRegistered");
        require(publicKeys[to] != bytes32(0), "ReceiverNotRegistered");

        // Verify amount is encrypted under both sender's and receiver's keys
        // (proof from bundle — developer doesn't handle proofs)
        require(
            amount.verify_transfer(publicKeys[msg.sender], publicKeys[to]),
            "BadTransferProof"
        );

        // Subtract from sender, verify remaining balance ≥ 0
        uno newBal = balances[msg.sender].sub(amount);
        require(newBal.gt(uno.zero()), "InsufficientBalance");

        set balances[msg.sender] = newBal;
        set balances[to] = balances[to].add(amount);

        emit ConfidentialTransfer(msg.sender, to);
    }

    // Burn: subtract encrypted amount from sender's balance.
    function burn(uno burnAmount) external {
        require(publicKeys[msg.sender] != bytes32(0), "NotRegistered");

        uno newBal = balances[msg.sender].sub(burnAmount);
        require(newBal.gt(uno.zero()), "InsufficientBalance");

        set balances[msg.sender] = newBal;
        emit Burn(msg.sender);
    }

    function balanceOf(agent account) public view returns (uno) {
        return balances[account];
    }

    function getPublicKey(agent account) public view returns (bytes32) {
        return publicKeys[account];
    }
}
