pragma tolang 0.4.0;

import tolang.openlib.execution_binding.ExecutionBindingBook;
import tolang.openlib.sponsor.SponsorPolicyRelay;
import tolang.openlib.receipt.ReceiptBook;
import tolang.openlib.privacy.ConfidentialEscrow;

// SponsoredPrivateEscrowCheckout — sponsored confidential checkout coordinator.
//
// This example fuses:
// execution binding + sponsor relay + receipt + confidential escrow.

contract SponsoredPrivateEscrowCheckout {
    manifest {
        name: "SponsoredPrivateEscrowCheckout";
        version: "1.0.0";
        description: "Sponsored confidential checkout flow over execution binding, sponsor relay, receipt, and confidential escrow openlib packages";
    }

    agent owner;
    agent relay_actor;
    agent sponsor_actor;
    agent binding_addr;
    agent sponsor_addr;
    agent receipt_addr;
    agent escrow_addr;

    event SponsoredCheckoutPrepared(
        bytes32 indexed binding_id,
        bytes32 indexed receipt_id,
        bytes32 indexed escrow_id,
        u256 amount
    )
    event SponsoredCheckoutReleased(
        bytes32 indexed binding_id,
        bytes32 indexed receipt_id,
        bytes32 indexed escrow_id,
        agent target,
        u256 amount
    )
    event SponsoredCheckoutRefunded(
        bytes32 indexed binding_id,
        bytes32 indexed receipt_id,
        bytes32 indexed escrow_id,
        u256 amount
    )

    constructor(
        agent _owner,
        agent _relay_actor,
        agent _sponsor_actor,
        agent _binding_addr,
        agent _sponsor_addr,
        agent _receipt_addr,
        agent _escrow_addr
    ) {
        require(_owner != agent(0), "ZERO_OWNER");
        require(_relay_actor != agent(0), "ZERO_RELAY_ACTOR");
        require(_sponsor_actor != agent(0), "ZERO_SPONSOR_ACTOR");
        require(_binding_addr != agent(0), "ZERO_BINDING");
        require(_sponsor_addr != agent(0), "ZERO_SPONSOR");
        require(_receipt_addr != agent(0), "ZERO_RECEIPT");
        require(_escrow_addr != agent(0), "ZERO_ESCROW");

        set owner = _owner;
        set relay_actor = _relay_actor;
        set sponsor_actor = _sponsor_actor;
        set binding_addr = _binding_addr;
        set sponsor_addr = _sponsor_addr;
        set receipt_addr = _receipt_addr;
        set escrow_addr = _escrow_addr;
    }

    function preflight(
        agent payer,
        agent payee,
        bytes32 binding_id,
        bytes32 receipt_id,
        bytes32 escrow_id,
        u256 amount
    ) external returns (bool ok) {
        ExecutionBindingBook binding = ExecutionBindingBook(binding_addr);
        SponsorPolicyRelay sponsor = SponsorPolicyRelay(sponsor_addr);
        ReceiptBook receipt = ReceiptBook(receipt_addr);
        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);

        require(amount > 0, "ZERO_AMOUNT");
        require(binding.isConsumable(binding_id) == true, "BINDING_INACTIVE");
        require(sponsor.isRelayerActive(relay_actor) == true, "RELAYER_INACTIVE");
        require(receipt.statusOf(receipt_id) == 0, "RECEIPT_EXISTS");
        require(escrow.statusOf(escrow_id) == 1, "ESCROW_NOT_OPEN");
        require(escrow.payerOf(escrow_id) == payer, "PAYER_MISMATCH");
        require(escrow.payeeOf(escrow_id) == payee, "PAYEE_MISMATCH");
        require(escrow.receiptRefOf(escrow_id) == receipt_id, "RECEIPT_LINK_MISMATCH");

        emit SponsoredCheckoutPrepared(binding_id, receipt_id, escrow_id, amount);
        return true;
    }

    function executeSponsoredRelease(
        agent payer,
        agent payee,
        agent target,
        bytes data,
        bytes32 binding_id,
        bytes32 receipt_id,
        bytes32 escrow_id,
        u256 amount,
        bytes32 external_ref,
        bytes32 result_ref,
        bytes32 settlement_ref
    ) external returns (bool ok) {
        ExecutionBindingBook binding = ExecutionBindingBook(binding_addr);
        SponsorPolicyRelay sponsor = SponsorPolicyRelay(sponsor_addr);
        ReceiptBook receipt = ReceiptBook(receipt_addr);
        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);

        require(target != agent(0), "ZERO_TARGET");
        require(amount > 0, "ZERO_AMOUNT");
        require(binding.isConsumable(binding_id) == true, "BINDING_INACTIVE");
        require(sponsor.isRelayerActive(relay_actor) == true, "RELAYER_INACTIVE");
        require(receipt.statusOf(receipt_id) == 0, "RECEIPT_EXISTS");
        require(escrow.statusOf(escrow_id) == 1, "ESCROW_NOT_OPEN");
        require(escrow.payerOf(escrow_id) == payer, "PAYER_MISMATCH");
        require(escrow.payeeOf(escrow_id) == payee, "PAYEE_MISMATCH");
        require(escrow.receiptRefOf(escrow_id) == receipt_id, "RECEIPT_LINK_MISMATCH");

        bytes32 policy_hash = binding.policyHashOf(binding_id);
        bytes32 proof_ref = binding.proofRefOf(binding_id);

        receipt.openReceipt(
            receipt_id,
            payer,
            relay_actor,
            sponsor_actor,
            target,
            amount,
            policy_hash,
            binding_id,
            proof_ref,
            external_ref
        );
        require(binding.consume(binding_id, amount, receipt_id) == true, "BINDING_CONSUME_FAILED");
        require(sponsor.relay(target, data, payer, amount, policy_hash, binding_id, receipt_id) == true, "SPONSOR_RELAY_FAILED");
        escrow.releaseEscrow(escrow_id, settlement_ref);
        receipt.finalizeSuccess(receipt_id, result_ref, settlement_ref);

        emit SponsoredCheckoutReleased(binding_id, receipt_id, escrow_id, target, amount);
        return true;
    }

    function abortSponsoredRefund(
        agent payer,
        agent payee,
        bytes32 binding_id,
        bytes32 receipt_id,
        bytes32 escrow_id,
        u256 amount,
        bytes32 external_ref,
        bytes32 result_ref,
        bytes32 reason_ref
    ) external returns (bool ok) {
        ExecutionBindingBook binding = ExecutionBindingBook(binding_addr);
        ReceiptBook receipt = ReceiptBook(receipt_addr);
        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);

        require(amount > 0, "ZERO_AMOUNT");
        require(binding.isConsumable(binding_id) == true, "BINDING_INACTIVE");
        require(receipt.statusOf(receipt_id) == 0, "RECEIPT_EXISTS");
        require(escrow.statusOf(escrow_id) == 1, "ESCROW_NOT_OPEN");
        require(escrow.payerOf(escrow_id) == payer, "PAYER_MISMATCH");
        require(escrow.payeeOf(escrow_id) == payee, "PAYEE_MISMATCH");
        require(escrow.receiptRefOf(escrow_id) == receipt_id, "RECEIPT_LINK_MISMATCH");

        bytes32 policy_hash = binding.policyHashOf(binding_id);
        bytes32 proof_ref = binding.proofRefOf(binding_id);

        receipt.openReceipt(
            receipt_id,
            payer,
            relay_actor,
            sponsor_actor,
            payee,
            amount,
            policy_hash,
            binding_id,
            proof_ref,
            external_ref
        );
        binding.cancel(binding_id);
        receipt.finalizeFailure(receipt_id, result_ref);
        escrow.refundEscrow(escrow_id, reason_ref);

        emit SponsoredCheckoutRefunded(binding_id, receipt_id, escrow_id, amount);
        return true;
    }

    function sponsorRemaining() public view returns (u256 remaining) {
        SponsorPolicyRelay sponsor = SponsorPolicyRelay(sponsor_addr);
        return sponsor.remainingOf(relay_actor);
    }

    function receiptStatus(bytes32 receipt_id) public view returns (u256 status) {
        ReceiptBook receipt = ReceiptBook(receipt_addr);
        return receipt.statusOf(receipt_id);
    }

    function confidentialBalance(agent account) public view returns (uno balance) {
        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);
        return escrow.nativeBalance(account);
    }
}
