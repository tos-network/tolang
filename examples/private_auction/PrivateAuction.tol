pragma tolang 0.4.0;

// PrivateAuction — sealed-bid auction where bids are never revealed on-chain.
//
// Bidders submit encrypted bids. The auctioneer decrypts all bids off-chain,
// determines the winner, and posts only the winner identity on-chain.
//
// What's public:  who bid (participation), the winner
// What's hidden:  all bid amounts (including the winning bid)

contract PrivateAuction {
    agent auctioneer;
    bytes32 auctioneerPubKey;
    u64 bidDeadline_ms;
    u64 settleDeadline_ms;
    bool settled;
    u64 bidCount;

    agent winner;
    mapping(agent => bytes32) publicKeys;
    mapping(agent => uno) encryptedBids;
    mapping(agent => bool) hasBid;

    event BidSubmitted(agent indexed bidder)
    event AuctionSettled(agent indexed winner)

    constructor(
        agent _auctioneer,
        bytes32 _auctioneerPubKey,
        u64 _bidDeadline_ms,
        u64 _settleDeadline_ms
    ) {
        auctioneer = _auctioneer;
        auctioneerPubKey = _auctioneerPubKey;
        bidDeadline_ms = _bidDeadline_ms;
        settleDeadline_ms = _settleDeadline_ms;
        settled = false;
        bidCount = 0;
    }

    function registerPublicKey(bytes32 pubkey) external {
        publicKeys[msg.sender] = pubkey;
    }

    // Submit a sealed bid. The bid is an encrypted uno value.
    // Proof bundle ensures the bid is non-negative.
    function submitBid(uno encryptedBid) external {
        require(block.timestamp_ms <= bidDeadline_ms, "BiddingClosed");
        require(hasBid[msg.sender] != true, "AlreadyBid");
        require(publicKeys[msg.sender] != bytes32(0), "NotRegistered");

        // gt(bid, zero) verified via proof bundle — ensures non-negative
        require(encryptedBid.gt(uno.zero()), "InvalidBid");

        encryptedBids[msg.sender] = encryptedBid;
        hasBid[msg.sender] = true;
        bidCount = bidCount + 1;

        emit BidSubmitted(msg.sender);
    }

    // Settle: auctioneer posts the winner after decrypting bids off-chain.
    function settle(agent _winner) external {
        require(msg.sender == auctioneer, "OnlyAuctioneer");
        require(block.timestamp_ms > bidDeadline_ms, "BiddingNotClosed");
        require(block.timestamp_ms <= settleDeadline_ms, "SettlePeriodExpired");
        require(settled != true, "AlreadySettled");
        require(hasBid[_winner] == true, "WinnerDidNotBid");

        settled = true;
        winner = _winner;

        emit AuctionSettled(_winner);
    }

    function getEncryptedBid(agent bidder) public view returns (uno) {
        return encryptedBids[bidder];
    }

    function getWinner() public view returns (agent) {
        require(settled == true, "NotSettled");
        return winner;
    }

    function getBidCount() public view returns (u64) {
        return bidCount;
    }
}
