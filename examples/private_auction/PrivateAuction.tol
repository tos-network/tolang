pragma tolang 0.4.0;

// PrivateAuction — sealed-bid auction where bids are hidden until reveal.
//
// What's public:  who bid (participation), final winner + winning price
// What's hidden:  all bid amounts until reveal phase; losing bids stay hidden
//
// Phase 1 (Commit): bidders submit encrypted bids + range proof (bid ∈ [min, max])
// Phase 2 (Reveal): bidders reveal by providing ownership proofs
// Phase 3 (Settle): highest bidder wins
//
// Demonstrates:
//   - tos.proof.verify_arbitrary_range — bid within [minBid, maxBid]
//   - tos.proof.arbitrary_range_max_value — read range bound from proof
//   - tos.proof.verify_ownership + ownership_amount — decrypt bid at reveal
//   - tos.ciphertext.sub_scalar — shift range for proof verification

contract PrivateAuction {
    agent seller;
    bytes32 sellerPubKey;
    u64 minBid;
    u64 maxBid;
    u64 commitDeadline_ms;
    u64 revealDeadline_ms;
    bool settled;

    agent highestBidder;
    u64 highestBid;
    u64 bidCount;

    mapping(agent => bytes32) publicKeys;
    mapping(agent => ciphertext) encryptedBids;
    mapping(agent => bool) hasCommitted;
    mapping(agent => bool) hasRevealed;
    mapping(agent => u64) revealedBids;

    event BidCommitted(agent indexed bidder)
    event BidRevealed(agent indexed bidder, u64 amount)
    event AuctionSettled(agent indexed winner, u64 amount)

    constructor(
        agent _seller,
        bytes32 _sellerPubKey,
        u64 _minBid,
        u64 _maxBid,
        u64 _commitDeadline_ms,
        u64 _revealDeadline_ms
    ) {
        seller = _seller;
        sellerPubKey = _sellerPubKey;
        minBid = _minBid;
        maxBid = _maxBid;
        commitDeadline_ms = _commitDeadline_ms;
        revealDeadline_ms = _revealDeadline_ms;
        settled = false;
        highestBid = 0;
        bidCount = 0;
    }

    function registerPublicKey(bytes32 pubkey) external {
        publicKeys[msg.sender] = pubkey;
    }

    // Phase 1: Submit an encrypted bid with an arbitrary range proof.
    //
    // To prove bid ∈ [minBid, maxBid], the bidder:
    //   1. Encrypts bid under their own key
    //   2. Subtracts minBid homomorphically → Encrypt(bid - minBid)
    //   3. Proves (bid - minBid) ∈ [0, maxBid - minBid] via arbitrary range proof
    function commitBid(
        ciphertext encryptedBid,
        bytes arbitraryRangeProof
    ) external {
        require(block.timestamp_ms <= commitDeadline_ms, "CommitPhaseClosed");
        require(hasCommitted[msg.sender] != true, "AlreadyCommitted");

        bytes32 pubkey = publicKeys[msg.sender];
        require(pubkey != bytes32(0), "NotRegistered");

        // Shift range: subtract minBid so we prove value ∈ [0, maxBid-minBid]
        ciphertext adjustedCt = tos.ciphertext.sub_scalar(encryptedBid, minBid);

        bytes32 t = tos.transcript.new("auction-bid-range");

        require(
            tos.proof.verify_arbitrary_range(pubkey, adjustedCt, arbitraryRangeProof, t),
            "BadRangeProof"
        );

        // Verify the proof's max_value matches our expected range
        u64 proofMax = tos.proof.arbitrary_range_max_value(arbitraryRangeProof);
        require(proofMax == maxBid - minBid, "RangeMismatch");

        encryptedBids[msg.sender] = encryptedBid;
        hasCommitted[msg.sender] = true;
        bidCount = bidCount + 1;

        emit BidCommitted(msg.sender);
    }

    // Phase 2: Reveal bid with an ownership proof.
    function revealBid(bytes ownershipProofBytes) external {
        require(block.timestamp_ms > commitDeadline_ms, "CommitPhaseNotClosed");
        require(block.timestamp_ms <= revealDeadline_ms, "RevealPhaseClosed");
        require(hasCommitted[msg.sender] == true, "NoBidCommitted");
        require(hasRevealed[msg.sender] != true, "AlreadyRevealed");

        bytes32 pubkey = publicKeys[msg.sender];
        ciphertext encBid = encryptedBids[msg.sender];

        bytes32 t = tos.transcript.new("auction-bid-reveal");

        require(
            tos.proof.verify_ownership(pubkey, encBid, ownershipProofBytes, t),
            "BadOwnershipProof"
        );

        u64 amount = tos.proof.ownership_amount(ownershipProofBytes);
        revealedBids[msg.sender] = amount;
        hasRevealed[msg.sender] = true;

        if (amount > highestBid) {
            highestBidder = msg.sender;
            highestBid = amount;
        }

        emit BidRevealed(msg.sender, amount);
    }

    // Phase 3: Settle the auction.
    function settle() external {
        require(block.timestamp_ms > revealDeadline_ms, "RevealPhaseNotClosed");
        require(settled != true, "AlreadySettled");
        require(msg.sender == seller, "OnlySeller");

        settled = true;
        emit AuctionSettled(highestBidder, highestBid);
    }

    function getHighestBid() public view returns (u64) {
        require(settled == true, "NotSettled");
        return highestBid;
    }

    function getWinner() public view returns (agent) {
        require(settled == true, "NotSettled");
        return highestBidder;
    }
}
