pragma tolang 0.4.0;

// PrivateOTC — confidential over-the-counter token swap.
//
// Two parties agree on a trade off-chain, then settle atomically on-chain
// without revealing the amounts to anyone else. The maker posts an encrypted
// offer; the taker fills it with a matching encrypted counter-offer. Both
// sides provide proofs that their encrypted amounts are what they agreed on.
//
// What's public:  maker/taker identities, that a deal settled, the token pair
// What's hidden:  the amounts on both sides of the trade
//
// Why privacy matters here:
//   - OTC desks handle large block trades; visible amounts cause slippage
//   - Competitors watching on-chain can front-run or copy trade strategies
//   - Both parties want to prove they delivered without revealing to the market
//
// Demonstrates:
//   - tos.ciphertext.encrypt + from_parts — construct encrypted offer
//   - tos.proof.verify_ct_validity — both sides encrypted under correct keys
//   - tos.proof.verify_commitment_eq — committed amount matches encrypted
//   - tos.proof.verify_range — amounts are non-negative
//   - tos.ciphertext.sub / add — atomic balance updates

contract PrivateOTC {
    agent tokenA;
    agent tokenB;
    u64 nextDealId;

    mapping(agent => bytes32) publicKeys;

    // Per-deal state
    mapping(u64 => agent) dealMaker;
    mapping(u64 => agent) dealTaker;
    mapping(u64 => ciphertext) dealMakerAmount;   // amount of tokenA maker gives
    mapping(u64 => ciphertext) dealTakerAmount;    // amount of tokenB taker gives
    mapping(u64 => bool) dealOpen;
    mapping(u64 => bool) dealSettled;

    // Encrypted balances per user per token side (A or B)
    mapping(agent => ciphertext) balancesA;
    mapping(agent => ciphertext) balancesB;

    event PublicKeyRegistered(agent indexed account)
    event DealCreated(u64 indexed dealId, agent indexed maker)
    event DealFilled(u64 indexed dealId, agent indexed taker)
    event Deposit(agent indexed account, bool indexed isTokenA, u64 amount)

    constructor(agent _tokenA, agent _tokenB) {
        tokenA = _tokenA;
        tokenB = _tokenB;
        nextDealId = 0;
    }

    function registerPublicKey(bytes32 pubkey) external {
        publicKeys[msg.sender] = pubkey;
        emit PublicKeyRegistered(msg.sender);
    }

    // Deposit plaintext amount into encrypted balance (shield operation).
    function deposit(bool isTokenA, u64 amount) external {
        bytes32 pubkey = publicKeys[msg.sender];
        require(pubkey != bytes32(0), "NotRegistered");

        ciphertext freshCt = tos.ciphertext.encrypt(pubkey, amount);

        if (isTokenA) {
            balancesA[msg.sender] = tos.ciphertext.add(balancesA[msg.sender], freshCt);
        } else {
            balancesB[msg.sender] = tos.ciphertext.add(balancesB[msg.sender], freshCt);
        }

        emit Deposit(msg.sender, isTokenA, amount);
    }

    // Maker creates a deal: "I'll give X of tokenA for Y of tokenB."
    // Both amounts are encrypted. The maker proves their tokenA balance can cover it.
    //
    //   offerCt     — encrypted amount of tokenA the maker offers
    //   commitment  — Pedersen commitment to the offer amount
    //   handle      — ElGamal handle under maker's key
    //   sourceCommitment — commitment to maker's remaining balance
    //   commitmentEqProof — proves remaining balance matches sourceCommitment
    //   rangeProof  — proves remaining balance ≥ 0
    function createDeal(
        ciphertext offerCt,
        bytes32 commitment,
        bytes32 handle,
        bytes32 sourceCommitment,
        bytes commitmentEqProof,
        bytes rangeProof
    ) external returns (u64) {
        bytes32 makerPub = publicKeys[msg.sender];
        require(makerPub != bytes32(0), "NotRegistered");

        bytes32 t = tos.transcript.new("otc-create-deal");

        // Verify maker has sufficient tokenA balance
        ciphertext makerBal = balancesA[msg.sender];
        ciphertext transferCt = tos.ciphertext.from_parts(commitment, handle);
        ciphertext newMakerBal = tos.ciphertext.sub(makerBal, transferCt);

        require(
            tos.proof.verify_commitment_eq(
                makerPub, newMakerBal, sourceCommitment,
                commitmentEqProof, t
            ),
            "BadCommitmentEqProof"
        );

        require(
            tos.proof.verify_range(sourceCommitment, rangeProof, 64, t),
            "BadRangeProof"
        );

        // Deduct from maker's tokenA balance
        balancesA[msg.sender] = newMakerBal;

        // Store deal
        u64 dealId = nextDealId;
        nextDealId = nextDealId + 1;
        dealMaker[dealId] = msg.sender;
        dealMakerAmount[dealId] = offerCt;
        dealOpen[dealId] = true;
        dealSettled[dealId] = false;

        emit DealCreated(dealId, msg.sender);
        return dealId;
    }

    // Taker fills a deal: provides their tokenB side with proofs.
    // On success:
    //   - Taker's tokenB balance is reduced (they pay)
    //   - Taker's tokenA balance is increased (they receive maker's offer)
    //   - Maker's tokenB balance is increased (they receive taker's payment)
    function fillDeal(
        u64 dealId,
        ciphertext paymentCt,
        bytes32 commitment,
        bytes32 handle,
        bytes32 sourceCommitment,
        bytes commitmentEqProof,
        bytes rangeProof
    ) external {
        require(dealOpen[dealId] == true, "DealNotOpen");
        require(dealSettled[dealId] != true, "DealAlreadySettled");

        bytes32 takerPub = publicKeys[msg.sender];
        require(takerPub != bytes32(0), "NotRegistered");

        bytes32 t = tos.transcript.new("otc-fill-deal");

        // Verify taker has sufficient tokenB balance
        ciphertext takerBal = balancesB[msg.sender];
        ciphertext transferCt = tos.ciphertext.from_parts(commitment, handle);
        ciphertext newTakerBal = tos.ciphertext.sub(takerBal, transferCt);

        require(
            tos.proof.verify_commitment_eq(
                takerPub, newTakerBal, sourceCommitment,
                commitmentEqProof, t
            ),
            "BadCommitmentEqProof"
        );

        require(
            tos.proof.verify_range(sourceCommitment, rangeProof, 64, t),
            "BadRangeProof"
        );

        // Execute atomic swap:
        // 1. Deduct tokenB from taker
        balancesB[msg.sender] = newTakerBal;

        // 2. Credit maker's tokenA offer to taker
        agent maker = dealMaker[dealId];
        ciphertext makerOffer = dealMakerAmount[dealId];

        // Re-encrypt maker's offer under taker's key for their balance
        // (The taker receives the ciphertext as-is; they'll need the maker's
        //  handle re-encrypted under their key. In practice the maker would
        //  provide a taker-handle at deal creation. Simplified here.)
        balancesA[msg.sender] = tos.ciphertext.add(balancesA[msg.sender], makerOffer);

        // 3. Credit taker's tokenB payment to maker
        balancesB[maker] = tos.ciphertext.add(balancesB[maker], paymentCt);

        // Mark deal as settled
        dealTaker[dealId] = msg.sender;
        dealTakerAmount[dealId] = paymentCt;
        dealSettled[dealId] = true;
        dealOpen[dealId] = false;

        emit DealFilled(dealId, msg.sender);
    }

    function getBalanceA(agent account) public view returns (ciphertext) {
        return balancesA[account];
    }

    function getBalanceB(agent account) public view returns (ciphertext) {
        return balancesB[account];
    }

    function isDealOpen(u64 dealId) public view returns (bool) {
        return dealOpen[dealId];
    }
}
