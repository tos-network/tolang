pragma tolang 0.4.0;

// PrivateOTC — confidential over-the-counter token swap.
//
// Two parties settle a trade atomically with encrypted amounts.
// The contract uses Uno.sub() and Uno.add() for balance updates,
// and Uno.gt() (via proof bundle) to verify sufficient balance.
//
// What's public:  maker/taker identities, that a deal settled
// What's hidden:  amounts on both sides of every trade, all balances

contract PrivateOTC {
    agent tokenA;
    agent tokenB;
    u64 nextDealId;

    mapping(agent => bytes32) publicKeys;

    mapping(u64 => agent) dealMaker;
    mapping(u64 => agent) dealTaker;
    mapping(u64 => Uno) dealOfferCt;
    mapping(u64 => Uno) dealPaymentCt;
    mapping(u64 => bool) dealOpen;
    mapping(u64 => bool) dealSettled;

    mapping(agent => Uno) balancesA;
    mapping(agent => Uno) balancesB;

    event PublicKeyRegistered(agent indexed account)
    event Deposited(agent indexed account, bool indexed isTokenA)
    event DealCreated(u64 indexed dealId, agent indexed maker)
    event DealFilled(u64 indexed dealId, agent indexed taker)

    constructor(agent _tokenA, agent _tokenB) {
        tokenA = _tokenA;
        tokenB = _tokenB;
        nextDealId = 0;
    }

    function registerPublicKey(bytes32 pubkey) external {
        publicKeys[msg.sender] = pubkey;
        emit PublicKeyRegistered(msg.sender);
    }

    // Deposit: encrypted amount created off-chain, submitted as Uno.
    function deposit(bool isTokenA, Uno depositAmount) external {
        require(publicKeys[msg.sender] != bytes32(0), "NotRegistered");

        if (isTokenA) {
            balancesA[msg.sender] = balancesA[msg.sender].add(depositAmount);
        } else {
            balancesB[msg.sender] = balancesB[msg.sender].add(depositAmount);
        }

        emit Deposited(msg.sender, isTokenA);
    }

    // Maker creates a deal: offer tokenA amount.
    function createDeal(Uno offerAmount) external returns (u64) {
        require(publicKeys[msg.sender] != bytes32(0), "NotRegistered");

        // Deduct from maker's tokenA balance
        Uno newBal = balancesA[msg.sender].sub(offerAmount);
        require(newBal.gt(Uno.zero()), "InsufficientBalance");
        balancesA[msg.sender] = newBal;

        u64 dealId = nextDealId;
        nextDealId = nextDealId + 1;
        dealMaker[dealId] = msg.sender;
        dealOfferCt[dealId] = offerAmount;
        dealOpen[dealId] = true;
        dealSettled[dealId] = false;

        emit DealCreated(dealId, msg.sender);
        return dealId;
    }

    // Taker fills a deal: provide tokenB payment, receive maker's tokenA.
    function fillDeal(u64 dealId, Uno paymentAmount) external {
        require(dealOpen[dealId] == true, "DealNotOpen");
        require(dealSettled[dealId] != true, "DealAlreadySettled");
        require(publicKeys[msg.sender] != bytes32(0), "NotRegistered");

        // Verify payment is encrypted under both taker's and maker's keys
        agent maker = dealMaker[dealId];
        require(
            paymentAmount.verify_transfer(publicKeys[msg.sender], publicKeys[maker]),
            "BadTransferProof"
        );

        // Deduct tokenB from taker
        Uno newTakerBal = balancesB[msg.sender].sub(paymentAmount);
        require(newTakerBal.gt(Uno.zero()), "InsufficientBalance");
        balancesB[msg.sender] = newTakerBal;

        // Atomic swap:
        // Taker receives maker's tokenA offer
        balancesA[msg.sender] = balancesA[msg.sender].add(dealOfferCt[dealId]);
        // Maker receives taker's tokenB payment
        balancesB[maker] = balancesB[maker].add(paymentAmount);

        dealTaker[dealId] = msg.sender;
        dealPaymentCt[dealId] = paymentAmount;
        dealSettled[dealId] = true;
        dealOpen[dealId] = false;

        emit DealFilled(dealId, msg.sender);
    }

    function getBalanceA(agent account) public view returns (Uno) {
        return balancesA[account];
    }

    function getBalanceB(agent account) public view returns (Uno) {
        return balancesB[account];
    }

    function isDealOpen(u64 dealId) public view returns (bool) {
        return dealOpen[dealId];
    }
}
