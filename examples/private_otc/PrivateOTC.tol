pragma tolang 0.4.0;

// PrivateOTC — confidential over-the-counter token swap.
//
// Two parties settle a trade atomically on-chain without revealing amounts.
// Both sides submit ciphertexts (encrypted off-chain) and prove they have
// sufficient balance via ZK proofs. The contract only does ct+ct / ct-ct.
//
// What's public:  maker/taker identities, that a deal settled, token pair
// What's hidden:  amounts on both sides of every trade, all balances
//
// Why privacy matters:
//   - OTC desks handle large block trades; visible amounts cause slippage
//   - Competitors watching on-chain can front-run or copy trade strategies

contract PrivateOTC {
    agent tokenA;
    agent tokenB;
    u64 nextDealId;

    mapping(agent => bytes32) publicKeys;

    // Per-deal state (all amounts are ciphertexts)
    mapping(u64 => agent) dealMaker;
    mapping(u64 => agent) dealTaker;
    mapping(u64 => ciphertext) dealOfferCt;    // tokenA amount maker gives
    mapping(u64 => ciphertext) dealPaymentCt;  // tokenB amount taker gives
    mapping(u64 => bool) dealOpen;
    mapping(u64 => bool) dealSettled;

    // Encrypted balances per user (all ciphertexts, no plaintext)
    mapping(agent => ciphertext) balancesA;
    mapping(agent => ciphertext) balancesB;

    event PublicKeyRegistered(agent indexed account)
    event Deposited(agent indexed account, bool indexed isTokenA)
    event DealCreated(u64 indexed dealId, agent indexed maker)
    event DealFilled(u64 indexed dealId, agent indexed taker)

    constructor(agent _tokenA, agent _tokenB) {
        tokenA = _tokenA;
        tokenB = _tokenB;
        nextDealId = 0;
    }

    function registerPublicKey(bytes32 pubkey) external {
        publicKeys[msg.sender] = pubkey;
        emit PublicKeyRegistered(msg.sender);
    }

    // Deposit: user creates encrypted ciphertext off-chain and submits it.
    // No plaintext amount enters the contract.
    function deposit(
        bool isTokenA,
        ciphertext depositCt,
        bytes rangeProof
    ) external {
        bytes32 pubkey = publicKeys[msg.sender];
        require(pubkey != bytes32(0), "NotRegistered");

        bytes32 commit = tos.ciphertext.commitment(depositCt);
        bytes32 t = tos.transcript.new("otc-deposit");
        require(
            tos.proof.verify_range(commit, rangeProof, 64, t),
            "BadRangeProof"
        );

        if (isTokenA) {
            balancesA[msg.sender] = tos.ciphertext.add(balancesA[msg.sender], depositCt);
        } else {
            balancesB[msg.sender] = tos.ciphertext.add(balancesB[msg.sender], depositCt);
        }

        emit Deposited(msg.sender, isTokenA);
    }

    // Maker creates a deal: offer tokenA ciphertext, prove balance covers it.
    function createDeal(
        ciphertext offerCt,
        bytes32 commitment,
        bytes32 handle,
        bytes32 sourceCommitment,
        bytes commitmentEqProof,
        bytes rangeProof
    ) external returns (u64) {
        bytes32 makerPub = publicKeys[msg.sender];
        require(makerPub != bytes32(0), "NotRegistered");

        bytes32 t = tos.transcript.new("otc-create-deal");

        // Subtract offer from maker's tokenA balance (ct - ct)
        ciphertext transferCt = tos.ciphertext.from_parts(commitment, handle);
        ciphertext newMakerBal = tos.ciphertext.sub(balancesA[msg.sender], transferCt);

        // Prove remaining balance ≥ 0
        require(
            tos.proof.verify_commitment_eq(
                makerPub, newMakerBal, sourceCommitment,
                commitmentEqProof, t
            ),
            "BadCommitmentEqProof"
        );
        require(
            tos.proof.verify_range(sourceCommitment, rangeProof, 64, t),
            "BadRangeProof"
        );

        balancesA[msg.sender] = newMakerBal;

        u64 dealId = nextDealId;
        nextDealId = nextDealId + 1;
        dealMaker[dealId] = msg.sender;
        dealOfferCt[dealId] = offerCt;
        dealOpen[dealId] = true;
        dealSettled[dealId] = false;

        emit DealCreated(dealId, msg.sender);
        return dealId;
    }

    // Taker fills a deal: provide tokenB ciphertext, prove balance covers it.
    // On success: taker gets maker's tokenA, maker gets taker's tokenB.
    function fillDeal(
        u64 dealId,
        ciphertext paymentCt,
        bytes32 commitment,
        bytes32 handle,
        bytes32 sourceCommitment,
        bytes commitmentEqProof,
        bytes rangeProof
    ) external {
        require(dealOpen[dealId] == true, "DealNotOpen");
        require(dealSettled[dealId] != true, "DealAlreadySettled");

        bytes32 takerPub = publicKeys[msg.sender];
        require(takerPub != bytes32(0), "NotRegistered");

        bytes32 t = tos.transcript.new("otc-fill-deal");

        // Subtract payment from taker's tokenB balance (ct - ct)
        ciphertext transferCt = tos.ciphertext.from_parts(commitment, handle);
        ciphertext newTakerBal = tos.ciphertext.sub(balancesB[msg.sender], transferCt);

        // Prove remaining balance ≥ 0
        require(
            tos.proof.verify_commitment_eq(
                takerPub, newTakerBal, sourceCommitment,
                commitmentEqProof, t
            ),
            "BadCommitmentEqProof"
        );
        require(
            tos.proof.verify_range(sourceCommitment, rangeProof, 64, t),
            "BadRangeProof"
        );

        // Atomic swap (all ct + ct / ct - ct):
        balancesB[msg.sender] = newTakerBal;
        balancesA[msg.sender] = tos.ciphertext.add(balancesA[msg.sender], dealOfferCt[dealId]);

        agent maker = dealMaker[dealId];
        balancesB[maker] = tos.ciphertext.add(balancesB[maker], paymentCt);

        dealTaker[dealId] = msg.sender;
        dealPaymentCt[dealId] = paymentCt;
        dealSettled[dealId] = true;
        dealOpen[dealId] = false;

        emit DealFilled(dealId, msg.sender);
    }

    function getBalanceA(agent account) public view returns (ciphertext) {
        return balancesA[account];
    }

    function getBalanceB(agent account) public view returns (ciphertext) {
        return balancesB[account];
    }

    function isDealOpen(u64 dealId) public view returns (bool) {
        return dealOpen[dealId];
    }
}
