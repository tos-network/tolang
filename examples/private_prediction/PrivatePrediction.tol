pragma tolang 0.4.0;

// PrivatePrediction — prediction market where bet amounts are hidden.
//
// Users bet on binary outcomes (YES/NO) with encrypted amounts. The contract
// accumulates all bets homomorphically. When the market resolves, the oracle
// computes each winner's payout off-chain and posts encrypted winnings.
//
// What's public:  who bet on which side, the winning outcome
// What's hidden:  all bet amounts, pool totals, individual winnings
//
// Why privacy matters:
//   - Visible bets cause herding (everyone copies the whale)
//   - Large bets move odds and invite front-running
//   - Private bets create fairer price discovery

contract PrivatePrediction {
    agent oracle;
    bytes32 oraclePubKey;
    u64 betDeadline_ms;
    bool resolved;
    bool outcome;

    // Encrypted pool totals — only the oracle can decrypt off-chain
    ciphertext encryptedYesPool;
    ciphertext encryptedNoPool;

    mapping(agent => bytes32) publicKeys;
    mapping(agent => ciphertext) yesBets;
    mapping(agent => ciphertext) noBets;
    mapping(agent => bool) hasBetYes;
    mapping(agent => bool) hasBetNo;
    mapping(agent => ciphertext) winnings;
    mapping(agent => bool) hasClaimed;

    event BetPlaced(agent indexed bettor, bool indexed side)
    event MarketResolved(bool outcome)
    event WinningsPosted(agent indexed winner)
    event WinningsClaimed(agent indexed winner)

    constructor(agent _oracle, bytes32 _oraclePubKey, u64 _betDeadline_ms) {
        oracle = _oracle;
        oraclePubKey = _oraclePubKey;
        betDeadline_ms = _betDeadline_ms;
        resolved = false;
        outcome = false;
    }

    function registerPublicKey(bytes32 pubkey) external {
        publicKeys[msg.sender] = pubkey;
    }

    // Place a bet on YES or NO.
    //
    // The bet ciphertext is encrypted off-chain under the oracle's public key.
    // A range proof ensures the bet is non-negative. No plaintext amount
    // enters the contract.
    function placeBet(
        bool betYes,
        ciphertext encryptedBet,
        bytes rangeProof
    ) external {
        require(block.timestamp_ms <= betDeadline_ms, "BettingClosed");
        require(resolved != true, "AlreadyResolved");

        bytes32 commit = tos.ciphertext.commitment(encryptedBet);
        bytes32 t = tos.transcript.new("private-prediction-bet");
        require(
            tos.proof.verify_range(commit, rangeProof, 64, t),
            "BadRangeProof"
        );

        if (betYes) {
            require(hasBetYes[msg.sender] != true, "AlreadyBetYes");
            yesBets[msg.sender] = encryptedBet;
            encryptedYesPool = tos.ciphertext.add(encryptedYesPool, encryptedBet);
            hasBetYes[msg.sender] = true;
        } else {
            require(hasBetNo[msg.sender] != true, "AlreadyBetNo");
            noBets[msg.sender] = encryptedBet;
            encryptedNoPool = tos.ciphertext.add(encryptedNoPool, encryptedBet);
            hasBetNo[msg.sender] = true;
        }

        emit BetPlaced(msg.sender, betYes);
    }

    // Oracle resolves the market: posts only the outcome (YES or NO).
    // Pool totals stay encrypted. Winner payouts are computed off-chain.
    function resolve(bool _outcome) external {
        require(msg.sender == oracle, "OnlyOracle");
        require(block.timestamp_ms > betDeadline_ms, "BettingNotClosed");
        require(resolved != true, "AlreadyResolved");

        resolved = true;
        outcome = _outcome;

        emit MarketResolved(_outcome);
    }

    // Oracle computes each winner's payout off-chain:
    //   payout = userBet × (totalPool / winningPool)
    //
    // The oracle decrypts all bets (it has the key), calculates the ratio,
    // and encrypts each payout under the winner's public key. It submits
    // the encrypted winnings with a range proof.
    //
    // No plaintext amount ever enters the contract.
    function postWinnings(
        agent winner,
        ciphertext encryptedPayout,
        bytes rangeProof
    ) external {
        require(msg.sender == oracle, "OnlyOracle");
        require(resolved == true, "NotResolved");
        require(hasClaimed[winner] != true, "AlreadyPosted");

        bytes32 commit = tos.ciphertext.commitment(encryptedPayout);
        bytes32 t = tos.transcript.new("post-winnings");
        require(
            tos.proof.verify_range(commit, rangeProof, 64, t),
            "BadRangeProof"
        );

        winnings[winner] = encryptedPayout;
        emit WinningsPosted(winner);
    }

    // Winner claims their payout.
    function claimWinnings() external {
        require(resolved == true, "NotResolved");
        require(hasClaimed[msg.sender] != true, "AlreadyClaimed");

        ciphertext w = winnings[msg.sender];
        bytes32 commit = tos.ciphertext.commitment(w);
        require(commit != bytes32(0), "NoWinningsPosted");

        hasClaimed[msg.sender] = true;
        emit WinningsClaimed(msg.sender);
    }

    function getEncryptedYesPool() public view returns (ciphertext) {
        return encryptedYesPool;
    }

    function getEncryptedNoPool() public view returns (ciphertext) {
        return encryptedNoPool;
    }

    function getWinnings(agent account) public view returns (ciphertext) {
        return winnings[account];
    }

    function isResolved() public view returns (bool) {
        return resolved;
    }
}
