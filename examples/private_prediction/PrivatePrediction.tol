pragma tolang 0.4.0;

// PrivatePrediction — prediction market where bet amounts are hidden.
//
// Users bet on YES/NO with encrypted uno amounts. The contract accumulates
// bets homomorphically. The oracle resolves the outcome and posts encrypted
// winnings for each winner.
//
// What's public:  who bet on which side, the winning outcome
// What's hidden:  all bet amounts, pool totals, individual winnings

contract PrivatePrediction {
    agent oracle;
    bytes32 oraclePubKey;
    u64 betDeadline_ms;
    bool resolved;
    bool outcome;

    uno encryptedYesPool;
    uno encryptedNoPool;

    mapping(agent => bytes32) publicKeys;
    mapping(agent => uno) yesBets;
    mapping(agent => uno) noBets;
    mapping(agent => bool) hasBetYes;
    mapping(agent => bool) hasBetNo;
    mapping(agent => uno) winnings;
    mapping(agent => bool) hasClaimed;

    event BetPlaced(agent indexed bettor, bool indexed side)
    event MarketResolved(bool outcome)
    event WinningsPosted(agent indexed winner)
    event WinningsClaimed(agent indexed winner)

    constructor(agent _oracle, bytes32 _oraclePubKey, u64 _betDeadline_ms) {
        set oracle = _oracle;
        set oraclePubKey = _oraclePubKey;
        set betDeadline_ms = _betDeadline_ms;
        set resolved = false;
        set outcome = false;
    }

    function registerPublicKey(bytes32 pubkey) external {
        set publicKeys[msg.sender] = pubkey;
    }

    // Place a bet. The uno value is encrypted off-chain under oracle's key.
    // Proof bundle ensures the bet is non-negative.
    function placeBet(bool betYes, uno encryptedBet) external {
        require(block.timestamp_ms <= betDeadline_ms, "BettingClosed");
        require(resolved != true, "AlreadyResolved");

        // Non-negative check via proof bundle
        require(encryptedBet.gt(uno.zero()), "InvalidBet");

        if (betYes) {
            require(hasBetYes[msg.sender] != true, "AlreadyBetYes");
            set yesBets[msg.sender] = encryptedBet;
            set encryptedYesPool = encryptedYesPool.add(encryptedBet);
            set hasBetYes[msg.sender] = true;
        } else {
            require(hasBetNo[msg.sender] != true, "AlreadyBetNo");
            set noBets[msg.sender] = encryptedBet;
            set encryptedNoPool = encryptedNoPool.add(encryptedBet);
            set hasBetNo[msg.sender] = true;
        }

        emit BetPlaced(msg.sender, betYes);
    }

    // Oracle resolves: posts only the outcome. Totals stay encrypted.
    function resolve(bool _outcome) external {
        require(msg.sender == oracle, "OnlyOracle");
        require(block.timestamp_ms > betDeadline_ms, "BettingNotClosed");
        require(resolved != true, "AlreadyResolved");

        set resolved = true;
        set outcome = _outcome;
        emit MarketResolved(_outcome);
    }

    // Oracle posts encrypted winnings for each winner (computed off-chain).
    function postWinnings(agent winner, uno encryptedPayout) external {
        require(msg.sender == oracle, "OnlyOracle");
        require(resolved == true, "NotResolved");
        require(hasClaimed[winner] != true, "AlreadyPosted");

        set winnings[winner] = encryptedPayout;
        emit WinningsPosted(winner);
    }

    function claimWinnings() external {
        require(resolved == true, "NotResolved");
        require(hasClaimed[msg.sender] != true, "AlreadyClaimed");
        require(winnings[msg.sender].gt(uno.zero()), "NoWinnings");

        set hasClaimed[msg.sender] = true;
        emit WinningsClaimed(msg.sender);
    }

    function getEncryptedYesPool() public view returns (uno) {
        return encryptedYesPool;
    }

    function getEncryptedNoPool() public view returns (uno) {
        return encryptedNoPool;
    }

    function getWinnings(agent account) public view returns (uno) {
        return winnings[account];
    }

    function isResolved() public view returns (bool) {
        return resolved;
    }
}
