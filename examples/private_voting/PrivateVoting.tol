pragma tolang 0.4.0;

// PrivateVoting — on-chain voting where individual votes are never revealed.
//
// Each voter encrypts their vote (0 or 1) off-chain under the tally
// authority's public key. The contract accumulates votes homomorphically.
// The final tally remains encrypted on-chain — only the tally authority
// can decrypt it off-chain and announce the result.
//
// What's public:  who voted (participation), that voting closed
// What's hidden:  each person's vote, the final tally (on-chain)
//
// The tally authority decrypts and publishes the result OFF-CHAIN.
// The contract itself never touches any plaintext number.

contract PrivateVoting {
    agent admin;
    bytes32 tallyPubKey;
    u64 deadline_ms;
    u64 voterCount;
    bool closed;

    ciphertext encryptedTally;
    mapping(agent => bool) hasVoted;
    mapping(agent => bool) eligible;

    event VoterRegistered(agent indexed voter)
    event VoteCast(agent indexed voter)
    event VotingClosed()

    constructor(agent _admin, bytes32 _tallyPubKey, u64 _deadline_ms) {
        admin = _admin;
        tallyPubKey = _tallyPubKey;
        deadline_ms = _deadline_ms;
        voterCount = 0;
        closed = false;
    }

    function registerVoter(agent voter) external {
        require(msg.sender == admin, "OnlyAdmin");
        require(eligible[voter] != true, "AlreadyRegistered");
        eligible[voter] = true;
        voterCount = voterCount + 1;
        emit VoterRegistered(voter);
    }

    // Cast an encrypted vote.
    //
    // The vote ciphertext encrypts 0 or 1 under tallyPubKey.
    // A 1-bit range proof guarantees the encrypted value is in {0, 1}.
    // The contract never learns what was voted — it only accumulates.
    function castVote(ciphertext encryptedVote, bytes rangeProof) external {
        require(block.timestamp_ms <= deadline_ms, "VotingClosed");
        require(closed != true, "VotingClosed");
        require(eligible[msg.sender] == true, "NotEligible");
        require(hasVoted[msg.sender] != true, "AlreadyVoted");

        // Verify vote is 0 or 1 (1-bit range proof)
        bytes32 voteCommitment = tos.ciphertext.commitment(encryptedVote);
        bytes32 t = tos.transcript.new("private-vote");
        require(
            tos.proof.verify_range(voteCommitment, rangeProof, 1, t),
            "BadRangeProof"
        );

        // Homomorphic tally: sum += encryptedVote (ct + ct)
        encryptedTally = tos.ciphertext.add(encryptedTally, encryptedVote);
        hasVoted[msg.sender] = true;

        emit VoteCast(msg.sender);
    }

    // Close voting. The encrypted tally stays on-chain.
    // The tally authority decrypts off-chain and publishes the result.
    function closeVoting() external {
        require(msg.sender == admin, "OnlyAdmin");
        require(block.timestamp_ms > deadline_ms, "VotingNotClosed");
        require(closed != true, "AlreadyClosed");
        closed = true;
        emit VotingClosed();
    }

    // The encrypted tally — only the tally authority can decrypt off-chain.
    function getEncryptedTally() public view returns (ciphertext) {
        return encryptedTally;
    }

    function getVoterCount() public view returns (u64) {
        return voterCount;
    }

    function isEligible(agent voter) public view returns (bool) {
        return eligible[voter];
    }

    function isClosed() public view returns (bool) {
        return closed;
    }
}
