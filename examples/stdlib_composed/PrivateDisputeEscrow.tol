pragma tolang 0.4.0;

import tolang.stdlib.privacy.ConfidentialEscrow;
import tolang.stdlib.privacy.AuditorDisclosureBook;
import tolang.stdlib.receipt.ReceiptBook;

// PrivateDisputeEscrow — confidential escrow + dispute disclosure + receipt coordinator.
//
// Combines ConfidentialEscrow for holding encrypted payment,
// AuditorDisclosureBook for arbitrator disclosure during disputes,
// and ReceiptBook for settlement receipts.

contract PrivateDisputeEscrow {
    manifest {
        name: "PrivateDisputeEscrow";
        version: "1.0.0";
        description: "Composed confidential dispute-escrow flow over ConfidentialEscrow, AuditorDisclosureBook, and ReceiptBook stdlib packages";
    }

    agent coordinator;
    agent escrow_addr;
    agent disclosure_addr;
    agent receipt_addr;

    mapping(bytes32 => bool) order_disputed;
    mapping(bytes32 => agent) order_payer;

    event OrderOpened(
        bytes32 indexed order_id,
        agent indexed payer,
        agent payee,
        u256 expiry_ms
    )
    event OrderSettled(
        bytes32 indexed order_id,
        bytes32 settlement_ref
    )
    event OrderDisputed(
        bytes32 indexed order_id,
        agent indexed arbitrator,
        bytes32 scope_ref
    )
    event DisputeResolved(
        bytes32 indexed order_id,
        bool payee_wins,
        bytes32 settlement_ref
    )

    constructor(agent _coordinator, agent _escrow_addr, agent _disclosure_addr, agent _receipt_addr) {
        require(_coordinator != agent(0), "ZERO_COORDINATOR");
        require(_escrow_addr != agent(0), "ZERO_ESCROW");
        require(_disclosure_addr != agent(0), "ZERO_DISCLOSURE");
        require(_receipt_addr != agent(0), "ZERO_RECEIPT");

        set coordinator = _coordinator;
        set escrow_addr = _escrow_addr;
        set disclosure_addr = _disclosure_addr;
        set receipt_addr = _receipt_addr;
    }

    function openOrder(bytes32 order_id, agent payee, u256 expiry_ms) public payable(uno) {
        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);
        ReceiptBook receipt = ReceiptBook(receipt_addr);

        set order_payer[order_id] = msg.sender;
        escrow.openEscrow(order_id, payee, expiry_ms, order_id);

        receipt.openReceipt(
            order_id,
            msg.sender,
            msg.sender,
            agent(0),
            payee,
            u256(msg.uno_value),
            bytes32(0),
            bytes32(0),
            bytes32(0),
            order_id
        );

        emit OrderOpened(order_id, msg.sender, payee, expiry_ms);
    }

    function settleOrder(bytes32 order_id, bytes32 settlement_ref) public {
        require(msg.sender == coordinator, "NOT_COORDINATOR");

        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);
        ReceiptBook receipt = ReceiptBook(receipt_addr);

        require(escrow.statusOf(order_id) == 1, "ESCROW_NOT_OPEN");

        escrow.releaseEscrow(order_id, settlement_ref);
        receipt.finalizeSuccess(order_id, settlement_ref, settlement_ref);

        emit OrderSettled(order_id, settlement_ref);
    }

    function disputeOrder(bytes32 order_id, agent arbitrator, bytes32 scope_ref, u256 disclosure_expiry_ms) public {
        require(msg.sender == coordinator, "NOT_COORDINATOR");

        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);
        AuditorDisclosureBook disclosure = AuditorDisclosureBook(disclosure_addr);

        require(escrow.statusOf(order_id) == 1, "ESCROW_NOT_OPEN");

        set order_disputed[order_id] = true;
        disclosure.authorizeAuditor(arbitrator, scope_ref, disclosure_expiry_ms);

        emit OrderDisputed(order_id, arbitrator, scope_ref);
    }

    function resolveDispute(bytes32 order_id, bool payee_wins, bytes32 settlement_ref) public {
        require(msg.sender == coordinator, "NOT_COORDINATOR");
        require(order_disputed[order_id] == true, "NOT_DISPUTED");

        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);
        ReceiptBook receipt = ReceiptBook(receipt_addr);

        require(escrow.statusOf(order_id) == 1, "ESCROW_NOT_OPEN");

        if (payee_wins) {
            escrow.releaseEscrow(order_id, settlement_ref);
            receipt.finalizeSuccess(order_id, settlement_ref, settlement_ref);
        } else {
            escrow.refundEscrowTo(order_id, order_payer[order_id], settlement_ref);
            receipt.finalizeFailure(order_id, settlement_ref);
        }

        set order_disputed[order_id] = false;

        emit DisputeResolved(order_id, payee_wins, settlement_ref);
    }

    function escrowStatus(bytes32 order_id) public view returns (u256 status) {
        ConfidentialEscrow escrow = ConfidentialEscrow(escrow_addr);
        return escrow.statusOf(order_id);
    }

    function receiptStatus(bytes32 order_id) public view returns (u256 status) {
        ReceiptBook receipt = ReceiptBook(receipt_addr);
        return receipt.statusOf(order_id);
    }
}
