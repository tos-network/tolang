pragma tolang 0.4.0;

import tolang.stdlib.agreement.CommercialAgreement;
import tolang.stdlib.settlement.TaskSettlement;
import tolang.stdlib.evidence.EvidenceBook;
import tolang.stdlib.trust.TrustRegistry;
import tolang.stdlib.discovery.ServiceDirectory;
import tolang.stdlib.privacy.ConfidentialVault;

// PrivateServiceOrder — confidential service-market coordinator.
//
// This example shows the market/execution plane composition:
// discovery + trust + agreement + evidence + settlement + privacy.

contract PrivateServiceOrder {
    manifest {
        name: "PrivateServiceOrder";
        version: "1.0.0";
        description: "Composed private service-order flow over agreement, settlement, evidence, trust, discovery, and privacy stdlib packages";
    }

    agent owner;
    agent agreement_addr;
    agent settlement_addr;
    agent evidence_addr;
    agent trust_addr;
    agent discovery_addr;
    agent vault_addr;

    event OrderReady(
        agent indexed provider,
        u256 indexed service_id,
        u256 indexed agreement_id,
        u256 task_id
    )
    event OrderSettled(
        agent indexed provider,
        u256 indexed service_id,
        u256 indexed agreement_id,
        u256 task_id,
        bytes32 evidence_id,
        bytes32 settlement_ref
    )
    event RouteAccepted(
        agent indexed provider,
        u256 indexed service_id,
        u256 service_kind,
        u256 capability_kind,
        u256 privacy_mode,
        u256 receipt_mode
    )

    constructor(
        agent _owner,
        agent _agreement_addr,
        agent _settlement_addr,
        agent _evidence_addr,
        agent _trust_addr,
        agent _discovery_addr,
        agent _vault_addr
    ) {
        require(_owner != agent(0), "ZERO_OWNER");
        require(_agreement_addr != agent(0), "ZERO_AGREEMENT");
        require(_settlement_addr != agent(0), "ZERO_SETTLEMENT");
        require(_evidence_addr != agent(0), "ZERO_EVIDENCE");
        require(_trust_addr != agent(0), "ZERO_TRUST");
        require(_discovery_addr != agent(0), "ZERO_DISCOVERY");
        require(_vault_addr != agent(0), "ZERO_VAULT");

        set owner = _owner;
        set agreement_addr = _agreement_addr;
        set settlement_addr = _settlement_addr;
        set evidence_addr = _evidence_addr;
        set trust_addr = _trust_addr;
        set discovery_addr = _discovery_addr;
        set vault_addr = _vault_addr;
    }

    function ready(
        agent provider,
        agent customer,
        agent auditor,
        u256 service_id,
        u256 agreement_id,
        u256 task_id,
        bytes32 evidence_id
    ) external returns (bool ok) {
        CommercialAgreement agreement = CommercialAgreement(agreement_addr);
        TaskSettlement settlement = TaskSettlement(settlement_addr);
        EvidenceBook evidence = EvidenceBook(evidence_addr);
        TrustRegistry trust = TrustRegistry(trust_addr);
        ServiceDirectory discovery = ServiceDirectory(discovery_addr);
        ConfidentialVault vault = ConfidentialVault(vault_addr);

        require(trust.isEligible(provider) == true, "PROVIDER_NOT_ELIGIBLE");
        require(discovery.isActive(service_id) == true, "SERVICE_INACTIVE");
        require(discovery.providerOf(service_id) == provider, "PROVIDER_MISMATCH");
        require(routeReady(service_id) == true, "SERVICE_ROUTE_UNSUITABLE");
        require(agreement.statusOf(agreement_id) >= 1, "AGREEMENT_UNKNOWN");
        require(settlement.statusOf(task_id) >= 1, "TASK_UNKNOWN");
        require(evidence.statusOf(evidence_id) >= 1, "EVIDENCE_UNKNOWN");
        require(vault.canAudit(customer, auditor) == true, "AUDIT_NOT_ALLOWED");

        emit RouteAccepted(
            provider,
            service_id,
            discovery.serviceKindOf(service_id),
            discovery.capabilityTypeOf(service_id),
            discovery.privacyModeOf(service_id),
            discovery.receiptModeOf(service_id)
        );
        emit OrderReady(provider, service_id, agreement_id, task_id);
        return true;
    }

    function settleReadyOrder(
        agent provider,
        agent customer,
        agent auditor,
        u256 service_id,
        u256 agreement_id,
        u256 task_id,
        bytes32 evidence_id,
        bytes32 settlement_ref
    ) external returns (bool ok) {
        CommercialAgreement agreement = CommercialAgreement(agreement_addr);
        TaskSettlement settlement = TaskSettlement(settlement_addr);
        EvidenceBook evidence = EvidenceBook(evidence_addr);
        TrustRegistry trust = TrustRegistry(trust_addr);
        ServiceDirectory discovery = ServiceDirectory(discovery_addr);
        ConfidentialVault vault = ConfidentialVault(vault_addr);

        require(trust.isEligible(provider) == true, "PROVIDER_NOT_ELIGIBLE");
        require(discovery.isActive(service_id) == true, "SERVICE_INACTIVE");
        require(discovery.providerOf(service_id) == provider, "PROVIDER_MISMATCH");
        require(routeReady(service_id) == true, "SERVICE_ROUTE_UNSUITABLE");
        require(agreement.statusOf(agreement_id) == 2, "AGREEMENT_NOT_ACCEPTED");
        require(settlement.statusOf(task_id) == 3, "TASK_NOT_SUBMITTED");
        require(evidence.isFinalized(evidence_id) == true, "EVIDENCE_NOT_FINAL");
        require(vault.canAudit(customer, auditor) == true, "AUDIT_NOT_ALLOWED");

        settlement.approveTask(task_id, settlement_ref);
        agreement.fulfill(agreement_id, settlement_ref);

        emit OrderSettled(provider, service_id, agreement_id, task_id, evidence_id, settlement_ref);
        return true;
    }

    function customerVaultBalance(agent customer) public view returns (uno balance) {
        ConfidentialVault vault = ConfidentialVault(vault_addr);
        return vault.balanceOf(customer);
    }

    function routeReady(u256 service_id) public view returns (bool ok) {
        ServiceDirectory discovery = ServiceDirectory(discovery_addr);
        if (discovery.isActive(service_id) != true) {
            return false;
        }
        u256 service_kind = discovery.serviceKindOf(service_id);
        if (service_kind != 4 && service_kind != 9) {
            return false;
        }
        u256 capability_kind = discovery.capabilityTypeOf(service_id);
        if (capability_kind != 4 && capability_kind != 7) {
            return false;
        }
        if (discovery.privacyModeOf(service_id) < 3) {
            return false;
        }
        if (discovery.receiptModeOf(service_id) < 3) {
            return false;
        }
        return true;
    }

    function serviceManifest(u256 service_id) public view returns (bytes32 manifest_ref) {
        ServiceDirectory discovery = ServiceDirectory(discovery_addr);
        return discovery.manifestRefOf(service_id);
    }
}
