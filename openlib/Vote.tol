pragma tolang 0.4.0;

// Vote — tally-and-threshold pattern.
//
// Replaces the former vote<T> compiler intrinsic with plain storage.
// Usage: declare mappings for voted/tally, threshold, deadline, and check quorum.

contract Vote {
    mapping(agent => bool) voted;
    u256 yes_count;
    u256 no_count;
    u256 threshold;       // basis points (e.g. 5000 = 50%)
    u256 deadline_ms;
    u256 eligible_count;

    event VoteCast(agent indexed voter, bool choice);
    event VoteInitialized(u256 threshold, u256 deadline_ms, u256 eligible);

    /// @notice Initialize a new vote round.
    function initialize(u256 _threshold, u256 _deadline_ms, u256 _eligible) external {
        set threshold = _threshold;
        set deadline_ms = _deadline_ms;
        set eligible_count = _eligible;
        set yes_count = 0;
        set no_count = 0;
        emit VoteInitialized(_threshold, _deadline_ms, _eligible);
    }

    /// @notice Cast a vote. Reverts if already voted.
    function cast(agent voter, bool choice) external {
        require(!voted[voter], "AlreadyVoted");
        set voted[voter] = true;
        if (choice) {
            set yes_count = yes_count + 1;
        } else {
            set no_count = no_count + 1;
        }
        emit VoteCast(voter, choice);
    }

    /// @notice Check whether the vote has reached quorum or deadline.
    function isDecided() public view returns (bool) {
        u256 total = yes_count + no_count;
        if (eligible_count > 0 && total * 10000 >= threshold * eligible_count) {
            return true;
        }
        if (deadline_ms > 0 && block.timestamp_ms >= deadline_ms) {
            return true;
        }
        return false;
    }

    /// @notice Get the vote result (1 = yes, 0 = no). Reverts if not decided.
    function result() public view returns (u256) {
        require(isDecided(), "VoteNotDecided");
        if (yes_count > no_count) {
            return 1;
        }
        return 0;
    }

    /// @notice Get total votes cast.
    function voteCount() public view returns (u256) {
        return yes_count + no_count;
    }
}
