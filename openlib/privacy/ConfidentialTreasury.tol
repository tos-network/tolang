pragma tolang 0.4.0;

package tolang.openlib.privacy;

// ConfidentialTreasury — multi-owner confidential treasury with selective disclosure.
//
// Allows multiple authorized signers to manage a shared encrypted balance,
// with auditor disclosure controls. The owner can add/remove signers,
// signers can authorize spends, and the owner executes or cancels them.

interface IConfidentialTreasury {
    event TreasuryDeposited(agent indexed depositor)
    event TreasuryWithdrawn(agent indexed owner, uno amount, bytes32 receipt_ref)
    event SignerAdded(agent indexed signer)
    event SignerRemoved(agent indexed signer)
    event SpendAuthorized(bytes32 indexed spend_id, agent indexed authorizer, agent indexed recipient, uno amount, bytes32 purpose_ref)
    event SpendExecuted(bytes32 indexed spend_id, bytes32 settlement_ref)
    event SpendCancelled(bytes32 indexed spend_id)
    event AuditorAuthorized(agent indexed auditor, bytes32 disclosure_ref)
    event AuditorRevoked(agent indexed auditor)

    function deposit() public payable(uno);
    function withdraw(uno amount, bytes32 receipt_ref) public;
    function addSigner(agent signer) public;
    function removeSigner(agent signer) public;
    function authorizeSpend(bytes32 spend_id, agent recipient, uno amount, bytes32 purpose_ref) public;
    function executeSpend(bytes32 spend_id, bytes32 settlement_ref) public;
    function cancelSpend(bytes32 spend_id) public;
    function authorizeAuditor(agent auditor, bytes32 disclosure_ref) public;
    function revokeAuditor(agent auditor) public;

    @verifiable
    function totalBalance() public view returns (uno balance);

    @verifiable
    function nativeBalance(agent account) public view returns (uno balance);

    @verifiable
    function isSigner(agent account) public view returns (bool ok);

    @verifiable
    function spendStatusOf(bytes32 spend_id) public view returns (u256 status);

    @verifiable
    function canAudit(agent auditor) public view returns (bool ok);

    @verifiable
    function disclosureRefOf(agent auditor) public view returns (bytes32 disclosure_ref);
}

contract ConfidentialTreasury is IConfidentialTreasury {
    manifest {
        name: "ConfidentialTreasury";
        version: "1.0.0";
        description: "Multi-owner confidential treasury with selective disclosure over UNO rails";
    }

    u8 constant STATUS_NONE = 0;
    u8 constant STATUS_PENDING = 1;
    u8 constant STATUS_EXECUTED = 2;
    u8 constant STATUS_CANCELLED = 3;

    uno treasury_balance;
    agent owner;

    mapping(agent => bool) signers;

    mapping(bytes32 => u8) spend_status;
    mapping(bytes32 => agent) spend_recipient;
    mapping(bytes32 => uno) spend_amount;
    mapping(bytes32 => bytes32) spend_purpose_ref;
    mapping(bytes32 => agent) spend_authorizer;

    mapping(agent => bool) auditor_allowed;
    mapping(agent => bytes32) auditor_disclosure_ref;

    event TreasuryDeposited(agent indexed depositor)
    event TreasuryWithdrawn(agent indexed owner, uno amount, bytes32 receipt_ref)
    event SignerAdded(agent indexed signer)
    event SignerRemoved(agent indexed signer)
    event SpendAuthorized(bytes32 indexed spend_id, agent indexed authorizer, agent indexed recipient, uno amount, bytes32 purpose_ref)
    event SpendExecuted(bytes32 indexed spend_id, bytes32 settlement_ref)
    event SpendCancelled(bytes32 indexed spend_id)
    event AuditorAuthorized(agent indexed auditor, bytes32 disclosure_ref)
    event AuditorRevoked(agent indexed auditor)

    constructor(agent _owner) {
        require(_owner != agent(0), "ZERO_OWNER");
        set owner = _owner;
    }

    function deposit() public payable(uno) {
        set treasury_balance = treasury_balance.add(msg.uno_value);
        emit TreasuryDeposited(msg.sender);
    }

    function withdraw(uno amount, bytes32 receipt_ref) public {
        require(msg.sender == owner, "NOT_OWNER");
        uno new_balance = treasury_balance.sub(amount);
        require(new_balance.gte(uno.zero()), "INSUFFICIENT_BALANCE");
        set treasury_balance = new_balance;
        uno.transfer(msg.sender, amount);
        emit TreasuryWithdrawn(msg.sender, amount, receipt_ref);
    }

    function addSigner(agent signer) public {
        require(msg.sender == owner, "NOT_OWNER");
        require(signer != agent(0), "ZERO_SIGNER");
        set signers[signer] = true;
        emit SignerAdded(signer);
    }

    function removeSigner(agent signer) public {
        require(msg.sender == owner, "NOT_OWNER");
        set signers[signer] = false;
        emit SignerRemoved(signer);
    }

    function authorizeSpend(bytes32 spend_id, agent recipient, uno amount, bytes32 purpose_ref) public {
        require(signers[msg.sender] == true, "NOT_SIGNER");
        require(spend_id != bytes32(0), "ZERO_SPEND_ID");
        require(recipient != agent(0), "ZERO_RECIPIENT");
        require(amount.gt(uno.zero()), "ZERO_AMOUNT");
        require(spend_status[spend_id] == STATUS_NONE, "SPEND_EXISTS");

        set spend_status[spend_id] = STATUS_PENDING;
        set spend_recipient[spend_id] = recipient;
        set spend_amount[spend_id] = amount;
        set spend_purpose_ref[spend_id] = purpose_ref;
        set spend_authorizer[spend_id] = msg.sender;

        emit SpendAuthorized(spend_id, msg.sender, recipient, amount, purpose_ref);
    }

    function executeSpend(bytes32 spend_id, bytes32 settlement_ref) public {
        require(msg.sender == owner, "NOT_OWNER");
        require(spend_status[spend_id] == STATUS_PENDING, "NOT_PENDING");

        uno amount = spend_amount[spend_id];
        uno new_balance = treasury_balance.sub(amount);
        require(new_balance.gte(uno.zero()), "INSUFFICIENT_BALANCE");

        set spend_status[spend_id] = STATUS_EXECUTED;
        set treasury_balance = new_balance;
        uno.transfer(spend_recipient[spend_id], amount);

        emit SpendExecuted(spend_id, settlement_ref);
    }

    function cancelSpend(bytes32 spend_id) public {
        require(msg.sender == owner || msg.sender == spend_authorizer[spend_id], "NOT_AUTHORIZED");
        require(spend_status[spend_id] == STATUS_PENDING, "NOT_PENDING");

        set spend_status[spend_id] = STATUS_CANCELLED;

        emit SpendCancelled(spend_id);
    }

    function authorizeAuditor(agent auditor, bytes32 disclosure_ref) public {
        require(msg.sender == owner, "NOT_OWNER");
        require(auditor != agent(0), "ZERO_AUDITOR");
        set auditor_allowed[auditor] = true;
        set auditor_disclosure_ref[auditor] = disclosure_ref;
        emit AuditorAuthorized(auditor, disclosure_ref);
    }

    function revokeAuditor(agent auditor) public {
        require(msg.sender == owner, "NOT_OWNER");
        set auditor_allowed[auditor] = false;
        set auditor_disclosure_ref[auditor] = bytes32(0);
        emit AuditorRevoked(auditor);
    }

    @verifiable
    function totalBalance() public view returns (uno balance) {
        return treasury_balance;
    }

    @verifiable
    function nativeBalance(agent account) public view returns (uno balance) {
        return uno.balance(account);
    }

    @verifiable
    function isSigner(agent account) public view returns (bool ok) {
        return signers[account];
    }

    @verifiable
    function spendStatusOf(bytes32 spend_id) public view returns (u256 status) {
        return u256(spend_status[spend_id]);
    }

    @verifiable
    function canAudit(agent auditor) public view returns (bool ok) {
        return auditor_allowed[auditor];
    }

    @verifiable
    function disclosureRefOf(agent auditor) public view returns (bytes32 disclosure_ref) {
        return auditor_disclosure_ref[auditor];
    }
}
