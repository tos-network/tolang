pragma tolang 0.4.0;

package tolang.openlib.recovery;

// RecoveryController — guardian-backed recovery plus emergency freeze.

interface IRecoveryController {
    event GuardianAdded(agent indexed guardian, u256 index)
    event GuardianRemoved(agent indexed guardian)
    event RecoveryStarted(agent indexed proposed_controller, u256 completes_at)
    event RecoveryApproved(agent indexed guardian, u256 approval_count)
    event RecoveryCancelled()
    event RecoveryExecuted(agent indexed old_controller, agent indexed new_controller)
    event Frozen(bytes32 reason_ref)
    event Unfrozen()

    function addGuardian(agent guardian) public;
    function removeGuardian(agent guardian) public;
    function startRecovery(agent new_controller) public;
    function approveRecovery() public;
    function executeRecovery() public;
    function cancelRecovery() public;
    function freeze(bytes32 reason_ref) public;
    function unfreeze() public;

    @verifiable
    function currentController() public view returns (agent controller);

    @verifiable
    function isFrozen() public view returns (bool ok);

    @verifiable
    function isRecoveryActive() public view returns (bool ok);

    @verifiable
    function approvalCount() public view returns (u256 count);
}

contract RecoveryController is IRecoveryController {
    manifest {
        name: "RecoveryController";
        version: "1.0.0";
        description: "Guardian-backed controller recovery with timelock, approval threshold, and emergency freeze";
    }

    agent controller;
    u256 guardian_count;
    u256 threshold;
    u256 timelock_ms;

    mapping(u256 => agent) guardians;
    mapping(agent => bool) is_guardian;

    bool frozen;
    bytes32 freeze_reason_ref;

    bool recovery_active;
    agent proposed_controller;
    u256 initiated_at_ms;
    u256 approval_count;
    u256 recovery_nonce;
    mapping(agent => u256) approved_at_nonce;

    event GuardianAdded(agent indexed guardian, u256 index)
    event GuardianRemoved(agent indexed guardian)
    event RecoveryStarted(agent indexed proposed_controller, u256 completes_at)
    event RecoveryApproved(agent indexed guardian, u256 approval_count)
    event RecoveryCancelled()
    event RecoveryExecuted(agent indexed old_controller, agent indexed new_controller)
    event Frozen(bytes32 reason_ref)
    event Unfrozen()

    constructor(agent _controller, u256 _threshold, u256 _timelock_ms) {
        require(_controller != agent(0), "ZERO_CONTROLLER");
        require(_threshold > 0, "ZERO_THRESHOLD");
        require(_timelock_ms > 0, "ZERO_TIMELOCK");
        set controller = _controller;
        set threshold = _threshold;
        set timelock_ms = _timelock_ms;
        set guardian_count = 0;
        set frozen = false;
        set recovery_active = false;
        set approval_count = 0;
        set recovery_nonce = 0;
    }

    function addGuardian(agent guardian) public {
        require(msg.sender == controller, "NOT_CONTROLLER");
        require(guardian != agent(0), "ZERO_GUARDIAN");
        require(guardian != controller, "CONTROLLER_GUARDIAN");
        require(is_guardian[guardian] != true, "ALREADY_GUARDIAN");
        set guardians[guardian_count] = guardian;
        set is_guardian[guardian] = true;
        set guardian_count = guardian_count + 1;
        emit GuardianAdded(guardian, guardian_count - 1);
    }

    function removeGuardian(agent guardian) public {
        require(msg.sender == controller, "NOT_CONTROLLER");
        require(recovery_active != true, "RECOVERY_ACTIVE");
        require(is_guardian[guardian] == true, "NOT_GUARDIAN");

        u256 next_count = guardian_count - 1;
        require(next_count >= threshold, "BELOW_THRESHOLD");

        set is_guardian[guardian] = false;
        set guardian_count = next_count;
        emit GuardianRemoved(guardian);
    }

    function startRecovery(agent new_controller) public {
        require(is_guardian[msg.sender] == true, "NOT_GUARDIAN");
        require(recovery_active != true, "ALREADY_ACTIVE");
        require(new_controller != agent(0), "ZERO_CONTROLLER");
        require(new_controller != controller, "ALREADY_CONTROLLER");

        set recovery_nonce = recovery_nonce + 1;
        set recovery_active = true;
        set proposed_controller = new_controller;
        set initiated_at_ms = block.timestamp_ms;
        set approval_count = 1;
        set approved_at_nonce[msg.sender] = recovery_nonce;

        emit RecoveryStarted(new_controller, block.timestamp_ms + timelock_ms);
    }

    function approveRecovery() public {
        require(is_guardian[msg.sender] == true, "NOT_GUARDIAN");
        require(recovery_active == true, "NOT_ACTIVE");
        require(approved_at_nonce[msg.sender] != recovery_nonce, "ALREADY_APPROVED");
        set approved_at_nonce[msg.sender] = recovery_nonce;
        set approval_count = approval_count + 1;
        emit RecoveryApproved(msg.sender, approval_count);
    }

    function executeRecovery() public {
        require(recovery_active == true, "NOT_ACTIVE");
        require(approval_count >= threshold, "INSUFFICIENT_APPROVALS");
        require(block.timestamp_ms >= initiated_at_ms + timelock_ms, "TIMELOCK");

        agent old_controller = controller;
        agent new_controller = proposed_controller;

        set controller = new_controller;
        set recovery_active = false;
        set proposed_controller = agent(0);
        set initiated_at_ms = 0;
        set approval_count = 0;
        set frozen = false;
        set freeze_reason_ref = bytes32(0);

        emit RecoveryExecuted(old_controller, new_controller);
    }

    function cancelRecovery() public {
        require(msg.sender == controller, "NOT_CONTROLLER");
        require(recovery_active == true, "NOT_ACTIVE");
        set recovery_active = false;
        set proposed_controller = agent(0);
        set initiated_at_ms = 0;
        set approval_count = 0;
        emit RecoveryCancelled();
    }

    function freeze(bytes32 reason_ref) public {
        require(msg.sender == controller || is_guardian[msg.sender] == true, "NOT_AUTHORIZED");
        set frozen = true;
        set freeze_reason_ref = reason_ref;
        emit Frozen(reason_ref);
    }

    function unfreeze() public {
        require(msg.sender == controller, "NOT_CONTROLLER");
        set frozen = false;
        set freeze_reason_ref = bytes32(0);
        emit Unfrozen();
    }

    @verifiable
    function currentController() public view returns (agent current) {
        return controller;
    }

    @verifiable
    function isFrozen() public view returns (bool ok) {
        return frozen;
    }

    @verifiable
    function isRecoveryActive() public view returns (bool ok) {
        return recovery_active;
    }

    @verifiable
    function approvalCount() public view returns (u256 count) {
        return approval_count;
    }
}
