pragma tolang 0.4.0;

interface IConfidentialEscrow {
  function openEscrow(bytes32 escrow_id, agent payee, u256 expiry_ms, bytes32 receipt_ref) public payable;
  function releaseEscrow(bytes32 escrow_id, bytes32 settlement_ref) public;
  function refundEscrow(bytes32 escrow_id, bytes32 reason_ref) public;
  function refundEscrowTo(bytes32 escrow_id, agent refundee, bytes32 reason_ref) public;
  function reclaimExpired(bytes32 escrow_id) public;
  function statusOf(bytes32 escrow_id) public view returns (u256 status);
  function amountOf(bytes32 escrow_id) public view returns (uno amount);
  function payerOf(bytes32 escrow_id) public view returns (agent payer);
  function payeeOf(bytes32 escrow_id) public view returns (agent payee);
  function receiptRefOf(bytes32 escrow_id) public view returns (bytes32 receipt_ref);
  function nativeBalance(agent account) public view returns (uno balance);
  event EscrowOpened(bytes32 escrow_id indexed, agent payer indexed, agent payee indexed, bytes32 receipt_ref, u256 expiry_ms);
  event EscrowReleased(bytes32 escrow_id indexed, agent releaser indexed, bytes32 settlement_ref);
  event EscrowRefunded(bytes32 escrow_id indexed, agent refunder indexed, bytes32 reason_ref);
}
