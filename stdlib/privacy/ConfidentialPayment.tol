pragma tolang 0.4.0;

package tolang.stdlib.privacy;

// ConfidentialPayment — batch and individual encrypted payment flows on UNO rails.
//
// This contract lets a payer send encrypted payments to one or more payees
// with receipt references and proof linkage. A coordinator authorizes
// releases and refunds.

interface IConfidentialPayment {
    event PaymentCreated(bytes32 indexed payment_id, agent indexed payer, agent indexed payee, bytes32 receipt_ref)
    event PaymentReleased(bytes32 indexed payment_id, bytes32 settlement_ref)
    event PaymentRefunded(bytes32 indexed payment_id, bytes32 reason_ref)
    event BatchCreated(bytes32 indexed batch_id, agent indexed depositor, bytes32 receipt_ref)
    event BatchPayeeAdded(bytes32 indexed batch_id, agent indexed payee, uno amount)
    event BatchReleased(bytes32 indexed batch_id, bytes32 settlement_ref)
    event BatchRefunded(bytes32 indexed batch_id, bytes32 reason_ref)

    function pay(bytes32 payment_id, agent payee, bytes32 receipt_ref) public payable(uno);
    function batchPay(bytes32 batch_id, bytes32 receipt_ref) public payable(uno);
    function addPayee(bytes32 batch_id, agent payee, uno amount) public;
    function releaseBatch(bytes32 batch_id, bytes32 settlement_ref) public;
    function refund(bytes32 payment_id, bytes32 reason_ref) public;
    function refundBatch(bytes32 batch_id, bytes32 reason_ref) public;

    @verifiable
    function statusOf(bytes32 payment_id) public view returns (u256 status);

    @verifiable
    function batchStatusOf(bytes32 batch_id) public view returns (u256 status);

    @verifiable
    function payerOf(bytes32 payment_id) public view returns (agent payer);

    @verifiable
    function payeeOf(bytes32 payment_id) public view returns (agent payee);

    @verifiable
    function receiptRefOf(bytes32 payment_id) public view returns (bytes32 receipt_ref);

    @verifiable
    function nativeBalance(agent account) public view returns (uno balance);
}

contract ConfidentialPayment is IConfidentialPayment {
    manifest {
        name: "ConfidentialPayment";
        version: "1.0.0";
        description: "Batch and individual confidential payment flows with receipt references over UNO rails";
    }

    u8 constant STATUS_NONE = 0;
    u8 constant STATUS_PENDING = 1;
    u8 constant STATUS_RELEASED = 2;
    u8 constant STATUS_REFUNDED = 3;

    agent coordinator;

    mapping(bytes32 => u8) payment_status;
    mapping(bytes32 => agent) payment_payer;
    mapping(bytes32 => agent) payment_payee;
    mapping(bytes32 => uno) payment_amount;
    mapping(bytes32 => bytes32) payment_receipt_ref;

    mapping(bytes32 => u8) batch_status;
    mapping(bytes32 => agent) batch_depositor;
    mapping(bytes32 => uno) batch_total;
    mapping(bytes32 => bytes32) batch_receipt_ref;
    mapping(bytes32 => u256) batch_payee_count;
    mapping(bytes32 => mapping(u256 => agent)) batch_payee_addr;
    mapping(bytes32 => mapping(u256 => uno)) batch_payee_amount;

    event PaymentCreated(bytes32 indexed payment_id, agent indexed payer, agent indexed payee, bytes32 receipt_ref)
    event PaymentReleased(bytes32 indexed payment_id, bytes32 settlement_ref)
    event PaymentRefunded(bytes32 indexed payment_id, bytes32 reason_ref)
    event BatchCreated(bytes32 indexed batch_id, agent indexed depositor, bytes32 receipt_ref)
    event BatchPayeeAdded(bytes32 indexed batch_id, agent indexed payee, uno amount)
    event BatchReleased(bytes32 indexed batch_id, bytes32 settlement_ref)
    event BatchRefunded(bytes32 indexed batch_id, bytes32 reason_ref)

    constructor(agent _coordinator) {
        require(_coordinator != agent(0), "ZERO_COORDINATOR");
        set coordinator = _coordinator;
    }

    function pay(bytes32 payment_id, agent payee, bytes32 receipt_ref) public payable(uno) {
        require(payment_id != bytes32(0), "ZERO_PAYMENT");
        require(payee != agent(0), "ZERO_PAYEE");
        require(payee != msg.sender, "SELF_PAYEE");
        require(payment_status[payment_id] == STATUS_NONE, "PAYMENT_EXISTS");
        require(msg.uno_value.gt(uno.zero()), "ZERO_AMOUNT");

        set payment_status[payment_id] = STATUS_PENDING;
        set payment_payer[payment_id] = msg.sender;
        set payment_payee[payment_id] = payee;
        set payment_amount[payment_id] = msg.uno_value;
        set payment_receipt_ref[payment_id] = receipt_ref;

        emit PaymentCreated(payment_id, msg.sender, payee, receipt_ref);
    }

    function batchPay(bytes32 batch_id, bytes32 receipt_ref) public payable(uno) {
        require(batch_id != bytes32(0), "ZERO_BATCH");
        require(batch_status[batch_id] == STATUS_NONE, "BATCH_EXISTS");
        require(msg.uno_value.gt(uno.zero()), "ZERO_AMOUNT");

        set batch_status[batch_id] = STATUS_PENDING;
        set batch_depositor[batch_id] = msg.sender;
        set batch_total[batch_id] = msg.uno_value;
        set batch_receipt_ref[batch_id] = receipt_ref;

        emit BatchCreated(batch_id, msg.sender, receipt_ref);
    }

    function addPayee(bytes32 batch_id, agent payee, uno amount) public {
        require(msg.sender == coordinator, "NOT_COORDINATOR");
        require(batch_status[batch_id] == STATUS_PENDING, "NOT_PENDING");
        require(payee != agent(0), "ZERO_PAYEE");
        require(amount.gt(uno.zero()), "ZERO_AMOUNT");

        u256 idx = batch_payee_count[batch_id];
        set batch_payee_addr[batch_id][idx] = payee;
        set batch_payee_amount[batch_id][idx] = amount;
        set batch_payee_count[batch_id] = idx + 1;

        emit BatchPayeeAdded(batch_id, payee, amount);
    }

    function releaseBatch(bytes32 batch_id, bytes32 settlement_ref) public {
        require(msg.sender == coordinator, "NOT_COORDINATOR");
        require(batch_status[batch_id] == STATUS_PENDING, "NOT_PENDING");

        u256 count = batch_payee_count[batch_id];
        require(count > 0, "NO_PAYEES");

        uno distributed = uno.zero();
        u256 i = 0;
        while (i < count) {
            uno amt = batch_payee_amount[batch_id][i];
            uno.transfer(batch_payee_addr[batch_id][i], amt);
            distributed = distributed.add(amt);
            i = i + 1;
        }

        require(batch_total[batch_id].gte(distributed), "OVERSPEND");

        set batch_status[batch_id] = STATUS_RELEASED;

        emit BatchReleased(batch_id, settlement_ref);
    }

    function refund(bytes32 payment_id, bytes32 reason_ref) public {
        require(msg.sender == coordinator, "NOT_COORDINATOR");
        require(payment_status[payment_id] == STATUS_PENDING, "NOT_PENDING");

        set payment_status[payment_id] = STATUS_REFUNDED;
        uno.transfer(payment_payer[payment_id], payment_amount[payment_id]);

        emit PaymentRefunded(payment_id, reason_ref);
    }

    function refundBatch(bytes32 batch_id, bytes32 reason_ref) public {
        require(msg.sender == coordinator, "NOT_COORDINATOR");
        require(batch_status[batch_id] == STATUS_PENDING, "NOT_PENDING");

        set batch_status[batch_id] = STATUS_REFUNDED;
        uno.transfer(batch_depositor[batch_id], batch_total[batch_id]);

        emit BatchRefunded(batch_id, reason_ref);
    }

    @verifiable
    function statusOf(bytes32 payment_id) public view returns (u256 status) {
        return u256(payment_status[payment_id]);
    }

    @verifiable
    function batchStatusOf(bytes32 batch_id) public view returns (u256 status) {
        return u256(batch_status[batch_id]);
    }

    @verifiable
    function payerOf(bytes32 payment_id) public view returns (agent payer) {
        return payment_payer[payment_id];
    }

    @verifiable
    function payeeOf(bytes32 payment_id) public view returns (agent payee) {
        return payment_payee[payment_id];
    }

    @verifiable
    function receiptRefOf(bytes32 payment_id) public view returns (bytes32 receipt_ref) {
        return payment_receipt_ref[payment_id];
    }

    @verifiable
    function nativeBalance(agent account) public view returns (uno balance) {
        return uno.balance(account);
    }
}
