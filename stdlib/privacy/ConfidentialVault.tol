pragma tolang 0.4.0;

package tolang.stdlib.privacy;

// ConfidentialVault — friendly confidential-value API over native UNO rails.
//
// This is the reference wrapper for:
//   - payable(uno) + msg.uno_value
//   - uno.balance(account)
//   - uno.transfer(account, amount)
//
// The contract also attaches a lightweight disclosure authorization surface so
// applications can bind auditor access without rebuilding the same plumbing.

interface IConfidentialVault {
    event PublicKeyRegistered(agent indexed account, bytes32 pubkey)
    event ConfidentialDeposited(agent indexed account)
    event ConfidentialWithdrawn(agent indexed account)
    event DisclosureAuthorized(agent indexed owner, agent indexed auditor, bytes32 disclosure_ref)
    event DisclosureRevoked(agent indexed owner, agent indexed auditor)

    function registerPublicKey(bytes32 pubkey) public;
    function deposit() public payable(uno);
    function withdraw(uno amount) public;
    function authorizeAuditor(agent auditor, bytes32 disclosure_ref) public;
    function revokeAuditor(agent auditor) public;

    @verifiable
    function balanceOf(agent account) public view returns (uno balance);

    @verifiable
    function nativeBalance(agent account) public view returns (uno balance);

    @verifiable
    function canAudit(agent owner, agent auditor) public view returns (bool ok);

    @verifiable
    function disclosureRefOf(agent owner, agent auditor) public view returns (bytes32 disclosure_ref);
}

contract ConfidentialVault is IConfidentialVault {
    manifest {
        name: "ConfidentialVault";
        version: "1.0.0";
        description: "Confidential deposit, withdraw, and disclosure-authority wrapper over UNO bridge primitives";
    }

    mapping(agent => uno) deposits;
    mapping(agent => bytes32) public_keys;
    mapping(agent => mapping(agent => bool)) auditor_allowed;
    mapping(agent => mapping(agent => bytes32)) auditor_disclosure_ref;

    event PublicKeyRegistered(agent indexed account, bytes32 pubkey)
    event ConfidentialDeposited(agent indexed account)
    event ConfidentialWithdrawn(agent indexed account)
    event DisclosureAuthorized(agent indexed owner, agent indexed auditor, bytes32 disclosure_ref)
    event DisclosureRevoked(agent indexed owner, agent indexed auditor)

    function registerPublicKey(bytes32 pubkey) public {
        require(pubkey != bytes32(0), "ZERO_PUBKEY");
        set public_keys[msg.sender] = pubkey;
        emit PublicKeyRegistered(msg.sender, pubkey);
    }

    function deposit() public payable(uno) {
        set deposits[msg.sender] = deposits[msg.sender].add(msg.uno_value);
        emit ConfidentialDeposited(msg.sender);
    }

    function withdraw(uno amount) public {
        uno new_balance = deposits[msg.sender].sub(amount);
        require(new_balance.gte(uno.zero()), "INSUFFICIENT_BALANCE");
        set deposits[msg.sender] = new_balance;
        uno.transfer(msg.sender, amount);
        emit ConfidentialWithdrawn(msg.sender);
    }

    function authorizeAuditor(agent auditor, bytes32 disclosure_ref) public {
        require(auditor != agent(0), "ZERO_AUDITOR");
        set auditor_allowed[msg.sender][auditor] = true;
        set auditor_disclosure_ref[msg.sender][auditor] = disclosure_ref;
        emit DisclosureAuthorized(msg.sender, auditor, disclosure_ref);
    }

    function revokeAuditor(agent auditor) public {
        set auditor_allowed[msg.sender][auditor] = false;
        set auditor_disclosure_ref[msg.sender][auditor] = bytes32(0);
        emit DisclosureRevoked(msg.sender, auditor);
    }

    @verifiable
    function balanceOf(agent account) public view returns (uno balance) {
        return deposits[account];
    }

    @verifiable
    function nativeBalance(agent account) public view returns (uno balance) {
        return uno.balance(account);
    }

    @verifiable
    function canAudit(agent owner, agent auditor) public view returns (bool ok) {
        return auditor_allowed[owner][auditor];
    }

    @verifiable
    function disclosureRefOf(agent owner, agent auditor) public view returns (bytes32 disclosure_ref) {
        return auditor_disclosure_ref[owner][auditor];
    }
}
